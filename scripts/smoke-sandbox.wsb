<Configuration>
  <Networking>Disable</Networking>
  <MemoryInMB>8192</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>{{REPO}}\release</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\zapfleet\release</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>{{REPO}}\scripts</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\zapfleet\scripts</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>{{REPO}}\smoke-results</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\zapfleet\smoke-results</SandboxFolder>
      <ReadOnly>false</ReadOnly>
